<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Font Families -->
    <FontFamily x:Key="MainFontFamily">Segoe UI Variable Text, Segoe UI, Inter, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeXs" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSizeSm" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeBase" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeMd" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="FontSizeLg" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeXl" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
    <sys:Double x:Key="FontSize2Xl" xmlns:sys="clr-namespace:System;assembly=mscorlib">26</sys:Double>
</ResourceDictionary>
