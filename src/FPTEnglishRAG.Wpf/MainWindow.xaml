<Window x:Class="FPTEnglishRAG.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FPTEnglishRAG.Wpf.ViewModels"
        xmlns:views="clr-namespace:FPTEnglishRAG.Wpf.Views"
        mc:Ignorable="d"
        Title="FPTEnglishRAG — Trợ lý Ôn thi Tiếng Anh FPT" 
        Height="780" Width="1180"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="{StaticResource MainFontFamily}">

    <Window.Resources>
        <!-- DataTemplates to render Views based on CurrentViewModel -->
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="240" />
            <!-- Main Content View Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Left Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- App Logo Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- Bottom Status / Info -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Logo Header -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="10"
                                Margin="0,0,12,0">
                            <Path Data="{StaticResource IconSparkles}"
                                  Fill="{StaticResource TextInverseBrush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FPTEnglishRAG"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="FPT Entry English AI"
                                       FontSize="{StaticResource FontSizeXs}"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu Links -->
                <StackPanel Grid.Row="1" Margin="8,16,8,0">
                    <TextBlock Text="MENU CHỨC NĂNG"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="16,0,0,10" />

                    <!-- Chat Tab -->
                    <RadioButton Style="{StaticResource NavTabButton}"
                                 GroupName="NavTabs"
                                 IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Chat">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChat}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0" />
                            <TextBlock Text="Trò chuyện (Chat)" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Documents Tab -->
                    <RadioButton Style="{StaticResource NavTabButton}"
                                 GroupName="NavTabs"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Documents">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocuments}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0" />
                            <TextBlock Text="Tài liệu (Documents)" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings Tab -->
                    <RadioButton Style="{StaticResource NavTabButton}"
                                 GroupName="NavTabs"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0" />
                            <TextBlock Text="Cài đặt (Settings)" />
                        </StackPanel>
                    </RadioButton>

                    <!-- About Tab -->
                    <RadioButton Style="{StaticResource NavTabButton}"
                                 GroupName="NavTabs"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="About">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0" />
                            <TextBlock Text="Giới thiệu (About)" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Status Indicator -->
                <Border Grid.Row="2"
                        Margin="12"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Trạng thái hệ thống"
                                       FontSize="{StaticResource FontSizeXs}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="RAG Pipeline: Sẵn sàng"
                                       FontSize="{StaticResource FontSizeXs}"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Content Area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Focusable="False" />
    </Grid>
</Window>
