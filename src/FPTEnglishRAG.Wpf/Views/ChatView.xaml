<UserControl x:Class="FPTEnglishRAG.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:FPTEnglishRAG.Wpf.ViewModels"
             xmlns:conv="clr-namespace:FPTEnglishRAG.Wpf.Converters"
             xmlns:behaviors="clr-namespace:FPTEnglishRAG.Wpf.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <conv:RoleToAlignmentConverter x:Key="RoleToAlignmentConv" />
        <conv:RoleToBackgroundConverter x:Key="RoleToBackgroundConv" />
        <conv:RoleToBorderConverter x:Key="RoleToBorderConv" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConv" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <conv:CountToVisibilityConverter x:Key="CountToVisConv" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Chat Layout Grid -->
        <Grid.RowDefinitions>
            <!-- Header Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Error Banner (if any) -->
            <RowDefinition Height="Auto" />
            <!-- Chat Messages Scroll Area -->
            <RowDefinition Height="*" />
            <!-- Input Area -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSparkles}"
                              Fill="{StaticResource PrimaryLightBrush}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Trợ lý Ôn thi Tiếng Anh FPT"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <!-- In-Memory Session Badge -->
                        <Border Background="{StaticResource PrimaryMutedBrush}"
                                BorderBrush="{StaticResource PrimaryHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="12,0,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="Phiên bộ nhớ tạm (In-Memory)"
                                       FontSize="{StaticResource FontSizeXs}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryLightBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Hỏi đáp ngữ pháp, từ vựng, bài đọc và cấu trúc đề thi — Câu trả lời có đối chiếu &amp; trích dẫn nguồn tài liệu [S#]"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Action: New Conversation / Clear -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding NewConversationCommand}"
                            ToolTip="Xóa lịch sử &amp; bắt đầu cuộc hội thoại mới">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="Đoạn chat mới" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Error Banner -->
        <Border Grid.Row="1"
                Background="{StaticResource DangerBgBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConv}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="Medium"
                           FontSize="{StaticResource FontSizeSm}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding RetryCommand}"
                        Content="Thử lại"
                        Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- 3. Message Stream List Area -->
        <Grid Grid.Row="2">
            <!-- Empty State / Welcome Screen -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="550"
                        Margin="24"
                        Visibility="{Binding Messages.Count, Converter={StaticResource InvBoolToVisConv}}">
                <Border Width="56" Height="56"
                        Background="{StaticResource PrimaryMutedBrush}"
                        BorderBrush="{StaticResource PrimaryHoverBrush}"
                        BorderThickness="1"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <Path Data="{StaticResource IconBookOpen}"
                          Fill="{StaticResource PrimaryLightBrush}"
                          Width="26" Height="26"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Chào mừng bạn đến với FPTEnglishRAG!"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <TextBlock Text="Hệ thống học tập thông minh hỗ trợ ôn luyện tiếng Anh đầu vào Đại học FPT bằng phương pháp RAG (Truy xuất tài liệu &amp; Dẫn chứng nguồn tin cậy)."
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,24" />

                <!-- Prompt Suggestions Card -->
                <Border Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="💡 Bạn có thể hỏi các câu như:"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource PrimaryLightBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="• Cấu trúc câu điều kiện loại 2 dùng trong trường hợp nào và có ví dụ gì?"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="• Phân biệt thì Hiện tại Hoàn thành (Present Perfect) và Quá khứ Đơn (Past Simple)?"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="• Giải thích các dạng câu hỏi Reading comprehension thường gặp trong đề thi FPT?"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Scrollable Message List -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          behaviors:ScrollToBottomBehavior.AutoScroll="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Grid Margin="0,10"
                                  HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignmentConv}}">
                                <Grid.ColumnDefinitions>
                                    <!-- Assistant Avatar Column -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Message Bubble Column -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Assistant Avatar Icon -->
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        Background="{StaticResource PrimaryMutedBrush}"
                                        BorderBrush="{StaticResource PrimaryHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisConv}}">
                                    <Path Data="{StaticResource IconSparkles}"
                                          Fill="{StaticResource PrimaryLightBrush}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <!-- Bubble Container -->
                                <Border Grid.Column="1"
                                        MaxWidth="680"
                                        Background="{Binding Role, Converter={StaticResource RoleToBackgroundConv}}"
                                        BorderBrush="{Binding Role, Converter={StaticResource RoleToBorderConv}}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16,12">
                                    <StackPanel Orientation="Vertical">
                                        <!-- Header role / time -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Sender Name -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Role, StringFormat='{}{0}'}"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FormattedTime}"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Grid>

                                        <!-- Message Content Text -->
                                        <TextBox Text="{Binding Content, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 FontFamily="{StaticResource MainFontFamily}"
                                                 FontSize="{StaticResource FontSizeBase}"
                                                 Padding="0"
                                                 Margin="0,0,0,4"
                                                 Cursor="Arrow" />

                                        <!-- Sending Loading Indicator -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding IsSending, Converter={StaticResource BoolToVisConv}}">
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="120" Height="4"
                                                         Foreground="{StaticResource PrimaryLightBrush}"
                                                         Background="{StaticResource InputBgBrush}"
                                                         BorderThickness="0" />
                                            <TextBlock Text="Đang xử lý..."
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       Foreground="{StaticResource PrimaryLightBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Citations Badges List -->
                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding Citations.Count, Converter={StaticResource CountToVisConv}}">
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,0,0,8" />

                                            <TextBlock Text="Nguồn trích dẫn (Citations):"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Margin="0,0,0,6" />

                                            <ItemsControl ItemsSource="{Binding Citations}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CitationViewModel}">
                                                        <Button Style="{StaticResource CitationBadgeButton}"
                                                                Command="{Binding DataContext.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding DocumentName}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconBookOpen}"
                                                                      Fill="{StaticResource SuccessBrush}"
                                                                      Width="10" Height="10"
                                                                      Stretch="Uniform"
                                                                      Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding Label}" />
                                                                <TextBlock Text=" • " />
                                                                <TextBlock Text="{Binding PageDisplay}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Failure State Action Card -->
                                        <Border Background="{StaticResource DangerBgBrush}"
                                                BorderBrush="{StaticResource DangerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,10,0,0"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisConv}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconRetry}"
                                                              Fill="{StaticResource TextInverseBrush}"
                                                              Width="12" Height="12"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="Thử lại câu hỏi này" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bottom Utility Actions (Copy) -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,6,0,0">
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="6,2"
                                                    Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Content}"
                                                    ToolTip="Sao chép nội dung">
                                                <Path Data="{StaticResource IconCopy}"
                                                      Fill="{StaticResource TextMutedBrush}"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 4. Input Area at Bottom -->
        <Border Grid.Row="3"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Multiline Input Box -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="QuestionTextBox"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding InputQuestion, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="68" MaxHeight="140"
                             Padding="14,10,90,10"
                             VerticalContentAlignment="Top" />

                    <!-- Floating Action Buttons on Right Inside Box -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,12">
                        <!-- Stop Button (Visible during streaming/busy) -->
                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConv}}"
                                ToolTip="Dừng tạo câu trả lời">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStop}"
                                      Fill="{StaticResource TextInverseBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,4,0" />
                                <TextBlock Text="Dừng" />
                            </StackPanel>
                        </Button>

                        <!-- Send Button -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendCommand}"
                                Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisConv}}"
                                IsDefault="True"
                                ToolTip="Gửi câu hỏi (Enter)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSend}"
                                      Fill="{StaticResource TextInverseBrush}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,4,0" />
                                <TextBlock Text="Gửi" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Input Footer Hint -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Nhấn 'Gửi' hoặc phím Enter để hỏi • Nhấn Shift+Enter để xuống dòng"
                               FontSize="{StaticResource FontSizeXs}"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="FPTEnglishRAG v1.0 • Grounded in Licensed Documents"
                               FontSize="{StaticResource FontSizeXs}"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 5. Citation Detail Dialog / Modal Flyout -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="#99000000"
              Visibility="{Binding IsCitationDialogOpen, Converter={StaticResource BoolToVisConv}}">
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    MaxWidth="600"
                    Margin="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource CitationBgBrush}"
                                    BorderBrush="{StaticResource CitationBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding SelectedCitation.Label}"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeSm}"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </Border>

                            <TextBlock Text="Chi tiết Đoạn trích dẫn nguồn"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CloseCitationCommand}"
                                Padding="6"
                                ToolTip="Đóng">
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Document Information -->
                    <Border Background="{StaticResource InputBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Tên tài liệu: "
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding SelectedCitation.DocumentName}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Vị trí trang: "
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedCitation.PageDisplay}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </Border>

                    <!-- Snippet Content -->
                    <TextBlock Text="Nội dung trích xuất từ tài liệu:"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />

                    <Border Background="{StaticResource SidebarBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedCitation.Snippet}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding CopyMessageCommand}"
                                CommandParameter="{Binding SelectedCitation.Snippet}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Sao chép đoạn trích" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding CloseCitationCommand}"
                                Content="Đóng" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
