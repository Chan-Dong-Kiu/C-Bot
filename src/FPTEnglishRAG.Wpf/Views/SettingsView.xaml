<UserControl x:Class="FPTEnglishRAG.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource AppBgBrush}">
    <Grid Margin="32">
        <StackPanel MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="64" Height="64"
                    Background="{StaticResource PrimaryMutedBrush}"
                    BorderBrush="{StaticResource PrimaryHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="32"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <Path Data="{StaticResource IconSettings}"
                      Fill="{StaticResource PrimaryLightBrush}"
                      Width="28" Height="28"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Title}"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSize2Xl}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <TextBlock Text="{Binding Description}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,24" />

            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="⚙️ Phạm vi phụ trách - Người 4:"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeMd}"
                               Foreground="{StaticResource PrimaryLightBrush}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="• Tích hợp Google Gemini REST API (Typed HttpClient, Polly Retry/Backoff)."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="• Bảo vệ API Key qua user-secrets hoặc Environment Variables (Không lưu vào source/DB)."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="• Cấu hình Model Gemini (Gemini 2.5 Flash / Pro, Embedding 004)."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="• Nút Test Connection kiểm tra kết nối API an toàn."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
