<UserControl x:Class="FPTEnglishRAG.Wpf.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource AppBgBrush}">
    <Grid Margin="32">
        <StackPanel MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="64" Height="64"
                    Background="{StaticResource PrimaryMutedBrush}"
                    BorderBrush="{StaticResource PrimaryHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="32"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <Path Data="{StaticResource IconDocuments}"
                      Fill="{StaticResource PrimaryLightBrush}"
                      Width="28" Height="28"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Title}"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="{StaticResource FontSize2Xl}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <TextBlock Text="{Binding Description}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,24" />

            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="📌 Phạm vi phụ trách - Người 2:"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeMd}"
                               Foreground="{StaticResource PrimaryLightBrush}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="• Trích xuất văn bản PDF bằng PdfPig và tệp TXT."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="• Chuẩn hóa dữ liệu, loại bỏ ký tự lỗi, bảo tồn cấu trúc đoạn/tiêu đề."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="• Chunking thông minh theo ranh giới câu/đoạn (Target 500 tokens, 75 overlap)."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="• Giao diện DataGrid quản lý danh sách tài liệu, tiến độ xử lý và xóa an toàn."
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
