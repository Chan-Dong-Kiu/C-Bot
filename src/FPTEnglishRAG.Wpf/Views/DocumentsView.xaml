<UserControl x:Class="FPTEnglishRAG.Wpf.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:FPTEnglishRAG.Wpf.ViewModels"
             xmlns:converters="clr-namespace:FPTEnglishRAG.Wpf.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:DocumentsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:DocumentStatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- Main Document Management Content -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý Tài liệu Học tập" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Nhập tài liệu ôn tập tiếng Anh (PDF/TXT) để tạo cơ sở dữ liệu tri thức RAG" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tải lại"
                            Command="{Binding LoadDocumentsCommand}"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            Background="#F1F5F9"
                            Foreground="#475569"
                            BorderThickness="1"
                            BorderBrush="#CBD5E1"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <Button Content="+ Import Tài liệu"
                            Command="{Binding ImportDocumentCommand}"
                            Padding="16,8"
                            Background="#0284C7"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 2. Error Banner -->
            <Border Grid.Row="1" 
                    Background="#FEF2F2" 
                    BorderBrush="#F87171" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="12,10" 
                    Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontWeight="Medium" TextWrapping="Wrap"/>
            </Border>

            <!-- 3. Live Ingestion Progress Card -->
            <Border Grid.Row="2" 
                    Background="#EFF6FF" 
                    BorderBrush="#BFDBFE" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,0,16"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentProcessingFileName, StringFormat='Đang xử lý: {0}'}" 
                                   FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" 
                                   FontWeight="Bold" Foreground="#1E40AF"/>
                    </Grid>

                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="8" Margin="0,0,0,8" Foreground="#0284C7"/>
                    <TextBlock Text="{Binding CurrentProgressStep}" FontSize="12" Foreground="#0284C7"/>
                </StackPanel>
            </Border>

            <!-- 4. Main Content Area: Search & DataGrid -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Filter Bar -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍 " VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" 
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="4,6"
                                 FontSize="13"/>
                    </Grid>
                </Border>

                <!-- Documents DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredDocuments}"
                          SelectedItem="{Binding SelectedDocument}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          Background="White"
                          RowHeight="48"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <!-- File Name -->
                        <DataGridTextColumn Header="Tên tài liệu" Binding="{Binding DisplayName}" Width="2*" FontWeight="Medium"/>

                        <!-- MIME Type -->
                        <DataGridTextColumn Header="Định dạng" Binding="{Binding MimeType}" Width="110" Foreground="#64748B"/>

                        <!-- Page Count -->
                        <DataGridTextColumn Header="Số trang" Binding="{Binding PageCount}" Width="80"/>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                                            CornerRadius="12" 
                                            Padding="10,4" 
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   Foreground="White" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Created At -->
                        <DataGridTextColumn Header="Ngày thêm" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" Foreground="#64748B"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Thao tác" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- View Content Button -->
                                        <Button Content="Xem nội dung" 
                                                Command="{Binding DataContext.ViewDocumentDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                Background="#E0F2FE"
                                                Foreground="#0369A1"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="11"
                                                FontWeight="SemiBold"/>

                                        <!-- Retry Button (Visible only when failed) -->
                                        <Button Content="Thử lại" 
                                                Command="{Binding DataContext.RetryDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisConverter}}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                Background="#FEF3C7"
                                                Foreground="#B45309"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="11"
                                                FontWeight="SemiBold"/>

                                        <!-- Delete Button -->
                                        <Button Content="Xóa" 
                                                Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                Background="#FEE2E2"
                                                Foreground="#DC2626"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="11"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- 5. Document Content / Chunks Inspector Drawer Overlay -->
        <Grid Background="#80000000"
              Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="620"
                    HorizontalAlignment="Right"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1,0,0,0">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Metadata summary -->
                        <RowDefinition Height="Auto"/>
                        <!-- Chunks Content List -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chi tiết nội dung tài liệu"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding ViewingDocument.DisplayName}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#0284C7"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕ Đóng"
                                Command="{Binding ClosePreviewCommand}"
                                Padding="12,6"
                                Background="#F1F5F9"
                                Foreground="#475569"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Metadata summary chips -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ViewingDocument.PageCount, StringFormat='Trang: {0}'}"
                                       FontWeight="SemiBold" Foreground="#334155" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding ViewingDocumentChunks.Count, StringFormat='Tổng đoạn (chunks): {0}'}"
                                       FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding ViewingDocument.MimeType, StringFormat='MIME: {0}'}"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Chunks Content List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Loading indicator -->
                            <TextBlock Text="Đang nạp các đoạn văn bản..."
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"
                                       Visibility="{Binding IsLoadingChunks, Converter={StaticResource BoolToVisConverter}}"/>

                            <!-- Empty message -->
                            <TextBlock Text="Tài liệu chưa có phân đoạn văn bản nào."
                                       Foreground="#94A3B8"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewingDocumentChunks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Chunk Items -->
                            <ItemsControl ItemsSource="{Binding ViewingDocumentChunks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <!-- Chunk Header -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Ordinal, StringFormat='Đoạn #{0}'}"
                                                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding PageStart, StringFormat='Trang {0}'}"
                                                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TokenCount, StringFormat='~{0} tokens'}"
                                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Chunk Content Text -->
                                                <TextBox Text="{Binding Content}"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="13"
                                                         Foreground="#1E293B"
                                                         FontFamily="{StaticResource MainFontFamily}"
                                                         Padding="0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
