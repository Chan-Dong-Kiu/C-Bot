{
  "Gemini": {
    "ApiKey": "set-this-only-in-appsettings.Local.json-user-secrets-or-GEMINI_API_KEY",
    "ApiKeyEnvironmentVariable": "GEMINI_API_KEY",
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta",
    "ChatModel": "gemini-3.7-flash",
    "EmbeddingModel": "gemini-embedding-001",
    "TimeoutSeconds": 30,
    "EmbeddingTimeoutSeconds": 20,
    "MaxRetries": 3,
    "Temperature": 0.2,
    "MaxOutputTokens": 2048,
    "UseFake": true
  },
  "Rag": {
    "TopK": 5,
    "RelevanceThreshold": 0.7,
    "IndexVersion": "v1",
    "MaxContextTokens": 3000,
    "MaxConversationMessages": 6
  },
  "ChatKnowledge": {
    "Mode": "AllowGeneralKnowledge"
  },
  "DocumentIngestion": {
    "MaxFileSizeMb": 25,
    "AllowedExtensions": [
      ".pdf",
      ".txt"
    ],
    "ChunkTargetTokens": 500,
    "ChunkOverlapTokens": 75,
    "ChunkMinTokens": 100,
    "ChunkMaxTokens": 700
  },
  "Storage": {
    "DatabasePath": "Data/fptenglishrag.db",
    "ImportedDocumentsPath": "Data/imported-documents"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
